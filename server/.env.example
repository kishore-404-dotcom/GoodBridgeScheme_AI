# GoodBridgeScheme AI Backend Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/goodscheme_db?retryWrites=true&w=majority
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=goodscheme_jwt_secret_hackathon_2026
NODE_ENV=development

# Optional: Gemini model and comma-separated backups used when it is overloaded
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
