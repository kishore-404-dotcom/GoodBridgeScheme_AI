# GoodBridgeScheme AI Backend Environment Variables
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development

# Optional: MongoDB Atlas (scheme catalog, translations, feedback, usage stats).
# Without it the server uses the built-in data. Database name defaults to "goodbridge".
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB=goodbridge

# Any long random text
JWT_SECRET=change_me_to_a_long_random_string
# Optional: enables GET /api/feedback/summary (send "Authorization: Bearer <token>")
ADMIN_TOKEN=

# Optional: Gemini model and comma-separated backups used when it is overloaded
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
